{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehboob-masih-portfolio-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "ENVIRONMENT": "local", "SITE_URL": "http://127.0.0.1:8787", "MEDIA_MODE": "git" },
  "d1_databases": [{ "binding": "DB", "database_name": "portfolio", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "env": {
    "staging": {
      "name": "mehboob-masih-portfolio-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "staging", "MEDIA_MODE": "git", "SITE_URL": "https://configure-staging-domain.invalid" },
      "d1_databases": [{ "binding": "DB", "database_name": "portfolio-staging", "database_id": "af8a60a5-6e22-4d81-827d-5cd7e73b6785", "migrations_dir": "migrations" }]
    }
  }
}