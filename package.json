{
  "name": "mehboob-masih-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:local": "wrangler d1 migrations apply portfolio --local",
    "preview": "wrangler dev --ip 127.0.0.1",
    "deploy:staging": "npm run check && wrangler deploy --env staging"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "hono": "^4.9.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}